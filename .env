# ==========================================
# SyncWave Configuration File
# ==========================================

# ------------------------------------------
# Server Configuration
# ------------------------------------------
# The external port exposed by Docker on your host machine.
# Change this if 8080 is already taken by another service (e.g., to 9090).
SYNCWAVE_PORT=8080

# Internal container port (do not change unless you modify the Dockerfile)
PORT=8080
HOST=0.0.0.0

# Security (Change this in production!)
JWT_SECRET=change-this-to-a-secure-random-32-character-secret-key
APP_ENV=production

# ------------------------------------------
# Storage Configuration
# ------------------------------------------
DATA_DIR=/data

# ------------------------------------------
# Download & Sync Configuration
# ------------------------------------------
SYNC_INTERVAL_MINUTES=60
MAX_CONCURRENT_DOWNLOADS=2

# Proxy (Optional)
# HTTP_PROXY=http://user:pass@proxy-host:port
